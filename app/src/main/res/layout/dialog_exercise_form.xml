<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#171717"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nuevo Ejercicio"
        android:textColor="#DFFF2E"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etDialogExerciseName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Nombre del ejercicio (Ej: Press de banca)"
        android:textColor="#FFFFFF"
        android:textColorHint="#777777"
        android:background="#222222"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="12dp"
        android:inputType="textPersonName"/>

    <EditText
        android:id="@+id/etDialogExerciseSeries"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Series (Ej: 4)"
        android:textColor="#FFFFFF"
        android:textColorHint="#777777"
        android:background="#222222"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="12dp"
        android:inputType="number"/>

    <EditText
        android:id="@+id/etDialogExerciseRepetitions"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Repeticiones (Ej: 12)"
        android:textColor="#FFFFFF"
        android:textColorHint="#777777"
        android:background="#222222"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="12dp"
        android:inputType="number"/>

    <EditText
        android:id="@+id/etDialogExerciseRest"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Descanso en segundos (Ej: 60)"
        android:textColor="#FFFFFF"
        android:textColorHint="#777777"
        android:background="#222222"
        android:paddingHorizontal="12dp"
        android:inputType="number"/>

</LinearLayout>