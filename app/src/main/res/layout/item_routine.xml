<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#171717"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <TextView
        android:id="@+id/tvRoutineName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre de la Rutina"
        android:textColor="#DFFF2E"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvRoutineObjective"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Objetivo de la rutina"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginBottom="12dp"/>

    <!-- Botón para gestionar los ejercicios de esta rutina específica -->
    <Button
        android:id="@+id/btnManageExercises"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:text="AGREGAR / VER EJERCICIOS"
        android:textColor="#000000"
        android:backgroundTint="#DFFF2E"
        android:textStyle="bold"
        android:textSize="11sp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnEdit"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:text="Editar"
            android:textColor="#000000"
            android:backgroundTint="#CCCCCC"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"
            android:paddingHorizontal="15dp"/>

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:text="Eliminar"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"
            android:paddingHorizontal="15dp"/>
    </LinearLayout>

</LinearLayout>